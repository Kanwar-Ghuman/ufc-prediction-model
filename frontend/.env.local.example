# Copy to frontend/.env.local. Contains no secrets: NEXT_PUBLIC_* is sent to the browser.

# Where the read-only prediction API is listening.
# Start it with:  cd model && uv run python -m octagon serve
# Locally this defaults to http://127.0.0.1:8000.
# On Vercel, leave it unset: pages use frontend/src/data/snapshot.json
# (refresh with `npm run snapshot` while the API is running).
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
