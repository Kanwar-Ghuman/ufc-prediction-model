# Copy to model/.env and fill in. That file is gitignored; never commit real keys.
# Both keys are optional: without them the matching fetch commands are skipped.
# Variable names are configurable in model/config.yaml under `scraping`/`betting`.

# The Odds API (https://the-odds-api.com) — used by `octagon fetch-odds`.
ODDS_API_KEY=

# YouTube Data API v3 — used by `octagon fetch-media` / `fetch-context`.
YOUTUBE_API_KEY=
